# Copia este archivo como ".env" y completa los valores reales.
# El archivo ".env" no se debe subir nunca a GitHub.

DECOLECTA_API_TOKEN=pega_aqui_tu_token_de_decolecta

# ID de tu carpeta de Google Drive (se toma del enlace que compartiste).
# El maestro se sube y actualiza automaticamente ahi via la API de Drive,
# sin necesidad de instalar ninguna aplicacion de escritorio.
# Ejemplo, si tu enlace es:
# https://drive.google.com/drive/folders/1K9ZVBmamkrsnBUUNsNLGspVBbyarN7bp
# entonces el ID es el texto despues de "folders/":
DRIVE_FOLDER_ID=1K9ZVBmamkrsnBUUNsNLGspVBbyarN7bp

# Opcional: ruta local donde tambien se guarda una copia del maestro en tu
# propia Mac. Si se deja vacio, se guarda dentro de la carpeta data/ del
# propio proyecto.
DRIVE_OUTPUT_PATH=

FLASK_SECRET_KEY=cambia-esta-clave-por-una-propia
